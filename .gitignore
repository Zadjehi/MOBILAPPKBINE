# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
keystore/
android/keystore.properties

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Claude Code local settings
.claude/

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# iOS pas construit pour l'instant (pas de compte Apple Developer) — /android
# n'est PLUS ignore : depuis qu'on ne passe plus par EAS Build, ce dossier est
# la source de verite du projet natif (comme un projet Android Studio classique,
# genere une seule fois par expo prebuild puis maintenu directement).
/ios

# Artefacts de build Android (regeneres a chaque compilation, jamais a committer)
android/.gradle/
android/.idea/
android/*.iml
android/app/.cxx/
android/app/build/
android/build/
android/local.properties
